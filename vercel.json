{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/server.cjs"
    },
    "api/[...path].ts": {
      "includeFiles": "dist/server.cjs"
    }
  }
}
